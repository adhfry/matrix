  Widget _buildInfoCards() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Informasi Penting',
            style: AppTextStyles.h6,
          ),
          const SizedBox(height: 12),
          _buildInfoCard(
            icon: Icons.info_outline,
            title: 'Pengumuman',
