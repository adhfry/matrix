import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:table_calendar/table_calendar.dart';
import 'package:intl/intl.dart';
import '../../../../core/theme/app_colors.dart';
import '../../../../core/theme/app_text_styles.dart';
import '../../../attendance/data/repositories/schedule_repository.dart';
import '../../../attendance/data/models/my_schedule_model.dart';

class ScheduleTab extends ConsumerStatefulWidget {
  const ScheduleTab({super.key});

  @override
  ConsumerState<ScheduleTab> createState() => _ScheduleTabState();
}

class _ScheduleTabState extends ConsumerState<ScheduleTab> with SingleTickerProviderStateMixin {
  late TabController _tabController;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 2, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        top: false,
        child: Column(
          children: [
            _buildHeader(),
            _buildTabBar(),
            Expanded(
              child: TabBarView(
                controller: _tabController,
                children: const [
                  MyScheduleView(),
                  TeamScheduleView(),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildHeader() {
    return Container(
      padding: const EdgeInsets.fromLTRB(16, 38, 16, 16),
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [AppColors.primary, AppColors.accent],
        ),
      ),
      child: Row(
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Jadwal',
                  style: AppTextStyles.h5.copyWith(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  'Lihat jadwal kerja Anda dan tim',
                  style: AppTextStyles.bodyMedium.copyWith(
                    color: Colors.white.withValues(alpha: 0.9),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTabBar() {
    return Container(
      color: Colors.white,
      child: TabBar(
        controller: _tabController,
        labelColor: AppColors.primary,
        unselectedLabelColor: AppColors.textSecondary,
        indicatorColor: AppColors.primary,
        indicatorWeight: 3,
        labelStyle: AppTextStyles.bodyMedium.copyWith(
          fontWeight: FontWeight.bold,
        ),
        unselectedLabelStyle: AppTextStyles.bodyMedium,
        tabs: const [
          Tab(text: 'Jadwal Saya'),
          Tab(text: 'Jadwal Tim'),
        ],
      ),
    );
  }
}

// ==================== MY SCHEDULE VIEW ====================
class MyScheduleView extends ConsumerWidget {
  const MyScheduleView({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final scheduleAsync = ref.watch(myScheduleProvider);

    return RefreshIndicator(
      onRefresh: () async {
        ref.invalidate(myScheduleProvider);
      },
      child: scheduleAsync.when(
        data: (schedules) {
          if (schedules.isEmpty) {
            return Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(Icons.calendar_today_outlined, size: 64, color: AppColors.textHint),
                  const SizedBox(height: 16),
                  Text(
                    'Tidak ada jadwal untuk 7 hari ke depan',
                    style: AppTextStyles.bodyMedium.copyWith(color: AppColors.textSecondary),
                  ),
                ],
              ),
            );
          }

          return ListView(
            padding: const EdgeInsets.all(16),
            children: [
              _buildCalendarGrid(schedules),
            ],
          );
        },
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (error, stack) => Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(Icons.error_outline, size: 64, color: AppColors.error),
              const SizedBox(height: 16),
              Text(
                'Gagal memuat jadwal',
                style: AppTextStyles.bodyMedium.copyWith(color: AppColors.error),
              ),
              const SizedBox(height: 8),
              Text(
                error.toString(),
                style: AppTextStyles.bodySmall.copyWith(color: AppColors.textSecondary),
                textAlign: TextAlign.center,
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildCalendarGrid(List<ScheduleModel> schedules) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.05),
            blurRadius: 10,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        children: schedules.map((schedule) => _buildScheduleCard(schedule)).toList(),
      ),
    );
  }

  Widget _buildScheduleCard(ScheduleModel schedule) {
    Color borderColor;
    Color bgColor;
    
    if (schedule.attendance != null) {
      if (schedule.attendance!.checkOut != null) {
        borderColor = AppColors.success;
        bgColor = AppColors.success.withValues(alpha: 0.05);
      } else {
        borderColor = AppColors.warning;
        bgColor = AppColors.warning.withValues(alpha: 0.05);
      }
    } else if (schedule.isToday) {
      borderColor = AppColors.primary;
      bgColor = AppColors.primary.withValues(alpha: 0.05);
    } else {
      borderColor = AppColors.border;
      bgColor = Colors.white;
    }

    // Get shift badge
    String? shiftBadge;
    Color? badgeColor;
    
    if (schedule.shift != null) {
      final shiftName = schedule.shift!.name.toLowerCase();
      if (shiftName.contains('pagi')) {
        shiftBadge = 'P';
        badgeColor = const Color(0xFF4CAF50); // Hijau
      } else if (shiftName.contains('siang')) {
        shiftBadge = 'S';
        badgeColor = const Color(0xFFFFB74D); // Kuning
      } else if (shiftName.contains('malam')) {
        shiftBadge = 'M';
        badgeColor = const Color(0xFF9C27B0); // Ungu
      }
    }
    
    // Check for leave/off/sick
    if (schedule.status != null && schedule.status != 'scheduled') {
      shiftBadge = 'I';
      badgeColor = const Color(0xFFF44336); // Merah for Izin/Cuti/Sakit/Libur
    }

    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
      decoration: BoxDecoration(
        color: bgColor,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: borderColor, width: 1.5),
      ),
      child: IntrinsicHeight(
        child: Row(
          children: [
            // Date Section with Badge
            Container(
              width: 90,
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: schedule.isToday
                    ? AppColors.primary.withValues(alpha: 0.1)
                    : Colors.transparent,
                borderRadius: const BorderRadius.only(
                  topLeft: Radius.circular(10),
                  bottomLeft: Radius.circular(10),
                ),
              ),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    schedule.dayShort,
                    style: AppTextStyles.caption.copyWith(
                      color: AppColors.textSecondary,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        schedule.dateNumber,
                        style: AppTextStyles.h5.copyWith(
                          fontWeight: FontWeight.bold,
                          color: schedule.isToday ? AppColors.primary : AppColors.textPrimary,
                        ),
                      ),
                      if (shiftBadge != null && badgeColor != null) ...[
                        const SizedBox(width: 4),
                        Container(
                          padding: const EdgeInsets.all(4),
                          decoration: BoxDecoration(
                            color: badgeColor,
                            borderRadius: BorderRadius.circular(4),
                          ),
                          child: Text(
                            shiftBadge,
                            style: AppTextStyles.caption.copyWith(
                              color: Colors.white,
                              fontSize: 10,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ),
                      ],
                    ],
                  ),
                  if (schedule.isToday) ...[
                    const SizedBox(height: 6),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                      decoration: BoxDecoration(
                        color: AppColors.primary,
                        borderRadius: BorderRadius.circular(4),
                      ),
                      child: Text(
                        'HARI INI',
                        style: AppTextStyles.caption.copyWith(
                          color: Colors.white,
                          fontSize: 8,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ],
                ],
              ),
            ),

            // Shift Details
            Expanded(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    // Shift Name
                    Text(
                      schedule.shift?.name ?? (schedule.status == 'leave' ? 'Cuti' : 
                                               schedule.status == 'sick' ? 'Sakit' :
                                               schedule.status == 'off' ? 'Libur' : 'Tidak ada shift'),
                      style: AppTextStyles.bodyMedium.copyWith(
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 8),

                    // Time Range
                    if (schedule.shift != null) ...[
                      Row(
                        children: [
                          Icon(Icons.access_time, size: 16, color: AppColors.textSecondary),
                          const SizedBox(width: 6),
                          Text(
                            '${schedule.shift!.checkInStart.substring(0, 5)} - ${schedule.shift!.checkOutStart.substring(0, 5)}',
                            style: AppTextStyles.bodySmall.copyWith(
                              color: AppColors.textSecondary,
                            ),
                          ),
                        ],
                      ),
                    ],

                    // Attendance Status
                    if (schedule.attendance != null) ...[
                      const SizedBox(height: 8),
                      Container(
                        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                        decoration: BoxDecoration(
                          color: schedule.attendance!.checkOut != null
                              ? AppColors.success.withValues(alpha: 0.1)
                              : AppColors.warning.withValues(alpha: 0.1),
                          borderRadius: BorderRadius.circular(6),
                        ),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(
                              schedule.attendance!.checkOut != null
                                  ? Icons.check_circle
                                  : Icons.timelapse,
                              size: 14,
                              color: schedule.attendance!.checkOut != null
                                  ? AppColors.success
                                  : AppColors.warning,
                            ),
                            const SizedBox(width: 4),
                            Text(
                              schedule.attendance!.checkOut != null
                                  ? 'Selesai (${schedule.attendance!.checkIn} - ${schedule.attendance!.checkOut})'
                                  : 'Sedang Berlangsung (${schedule.attendance!.checkIn})',
                              style: AppTextStyles.caption.copyWith(
                                color: schedule.attendance!.checkOut != null
                                    ? AppColors.success
                                    : AppColors.warning,
                                fontWeight: FontWeight.w600,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// ==================== TEAM SCHEDULE VIEW ====================
class TeamScheduleView extends ConsumerWidget {
  const TeamScheduleView({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final teamScheduleAsync = ref.watch(teamScheduleProvider);

    return RefreshIndicator(
      onRefresh: () async {
        ref.invalidate(teamScheduleProvider);
      },
      child: teamScheduleAsync.when(
        data: (data) {
          final users = data['users'] as List<TeamMemberSchedule>;
          final dateHeaders = data['date_headers'] as List<DateHeader>;

          if (users.isEmpty) {
            return Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(Icons.people_outline, size: 64, color: AppColors.textHint),
                  const SizedBox(height: 16),
                  Text(
                    'Tidak ada data tim',
                    style: AppTextStyles.bodyMedium.copyWith(color: AppColors.textSecondary),
                  ),
                ],
              ),
            );
          }

          return Column(
            children: [
              // Date Headers (Fixed)
              Container(
                color: Colors.white,
                child: _buildDateHeaders(dateHeaders),
              ),

              // Team Members List (Scrollable)
              Expanded(
                child: ListView.builder(
                  padding: const EdgeInsets.only(bottom: 16),
                  itemCount: users.length,
                  itemBuilder: (context, index) {
                    return _buildTeamMemberRow(users[index], dateHeaders);
                  },
                ),
              ),
            ],
          );
        },
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (error, stack) => Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(Icons.error_outline, size: 64, color: AppColors.error),
              const SizedBox(height: 16),
              Text(
                'Gagal memuat jadwal tim',
                style: AppTextStyles.bodyMedium.copyWith(color: AppColors.error),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildDateHeaders(List<DateHeader> headers) {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 12),
      decoration: BoxDecoration(
        color: AppColors.surfaceVariant,
        border: Border(
          bottom: BorderSide(color: AppColors.border, width: 1),
        ),
      ),
      child: Row(
        children: [
          const SizedBox(width: 120), // Space for name
          ...headers.map((header) {
            return Expanded(
              child: Column(
                children: [
                  Text(
                    header.dayShort,
                    style: AppTextStyles.caption.copyWith(
                      color: header.isToday ? AppColors.primary : AppColors.textSecondary,
                      fontWeight: header.isToday ? FontWeight.bold : FontWeight.normal,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: header.isToday ? AppColors.primary : Colors.transparent,
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Text(
                      header.dateNumber,
                      style: AppTextStyles.bodySmall.copyWith(
                        color: header.isToday ? Colors.white : AppColors.textPrimary,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
            );
          }).toList(),
        ],
      ),
    );
  }

  Widget _buildTeamMemberRow(TeamMemberSchedule member, List<DateHeader> headers) {
    return Container(
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.05),
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: IntrinsicHeight(
        child: Row(
          children: [
            // Member Info
            Container(
              width: 120,
              padding: const EdgeInsets.all(12),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    member.name,
                    style: AppTextStyles.bodySmall.copyWith(
                      fontWeight: FontWeight.bold,
                    ),
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                  ),
                  if (member.position != null) ...[
                    const SizedBox(height: 2),
                    Text(
                      member.position!,
                      style: AppTextStyles.caption.copyWith(
                        color: AppColors.textSecondary,
                      ),
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                  ],
                ],
              ),
            ),

            // Schedule Cells
            ...member.schedules.map((daySchedule) {
              final isToday = headers.firstWhere((h) => h.date == daySchedule.date).isToday;
              
              return Expanded(
                child: Container(
                  height: 70,
                  margin: const EdgeInsets.all(2),
                  decoration: BoxDecoration(
                    color: isToday 
                        ? AppColors.primary.withValues(alpha: 0.05)
                        : Colors.transparent,
                    borderRadius: BorderRadius.circular(6),
                  ),
                  child: daySchedule.schedule != null
                      ? _buildShiftCell(daySchedule.schedule!)
                      : Center(
                          child: Text(
                            '-',
                            style: AppTextStyles.bodySmall.copyWith(
                              color: AppColors.textHint,
                            ),
                          ),
                        ),
                ),
              );
            }).toList(),
          ],
        ),
      ),
    );
  }

  Widget _buildShiftCell(ShiftSchedule schedule) {
    if (schedule.shift == null) {
      return const Center(
        child: Text('-', style: TextStyle(color: Colors.grey)),
      );
    }

    Color bgColor = _parseColor(schedule.shift!.color).withValues(alpha: 0.15);
    Color textColor = _parseColor(schedule.shift!.color);

    // Status indicator
    Widget? statusIcon;
    if (schedule.attendanceStatus == 'On-Time' || schedule.attendanceStatus == 'Early') {
      statusIcon = Icon(Icons.check_circle, size: 10, color: AppColors.success);
    } else if (schedule.attendanceStatus == 'Late') {
      statusIcon = Icon(Icons.warning, size: 10, color: AppColors.warning);
    }

    return Container(
      padding: const EdgeInsets.all(4),
      decoration: BoxDecoration(
        color: bgColor,
        borderRadius: BorderRadius.circular(6),
      ),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Text(
            schedule.shift!.code,
            style: AppTextStyles.caption.copyWith(
              color: textColor,
              fontWeight: FontWeight.bold,
              fontSize: 10,
            ),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 2),
          Text(
            schedule.shift!.checkInStart,
            style: AppTextStyles.caption.copyWith(
              color: textColor,
              fontSize: 9,
            ),
          ),
          if (statusIcon != null) ...[
            const SizedBox(height: 2),
            statusIcon,
          ],
        ],
      ),
    );
  }

  Color _parseColor(String hexColor) {
    try {
      return Color(int.parse(hexColor.replaceFirst('#', '0xFF')));
    } catch (e) {
      return AppColors.primary;
    }
  }
}
